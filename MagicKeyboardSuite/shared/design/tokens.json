{
  "$comment": "Fuente única del diseño de Magic Keyboard Suite. NO edites Theme.swift ni Theme.xaml a mano: ejecuta `python3 shared/tools/generate.py`.",

  "colors": {
    "stateConnected":  { "light": "#0F7B0F", "dark": "#6CCB5F" },
    "statePaired":     { "light": "#9D5D00", "dark": "#FCE100" },
    "stateReleased":   { "light": "#7A3FC4", "dark": "#C29BFF" },
    "stateNearby":     { "light": "#005FB8", "dark": "#60CDFF" },
    "stateError":      { "light": "#C42B1C", "dark": "#FF99A4" },

    "cardBackground":  { "light": "#FFFFFFB3", "dark": "#FFFFFF0D" },
    "cardStroke":      { "light": "#0000000F", "dark": "#0000001A" },
    "iconTile":        { "light": "#0000000A", "dark": "#FFFFFF0F" },
    "badgeFillOpacity": 0.14
  },

  "radius": {
    "card": 8,
    "control": 4,
    "badge": 4,
    "iconTile": 8
  },

  "spacing": {
    "xs": 4,
    "s": 8,
    "m": 12,
    "l": 16,
    "xl": 24,
    "cardPaddingH": 20,
    "cardPaddingV": 16,
    "pagePaddingH": 36,
    "pagePaddingV": 24
  },

  "size": {
    "iconTile": 44,
    "cardIcon": 20,
    "tileIcon": 20,
    "statusDot": 8,
    "sidebarWidth": 268,
    "contentMaxWidth": 920,
    "windowMinWidth": 980,
    "windowMinHeight": 660,
    "comboWidth": 280
  },

  "typography": {
    "pageTitle":    { "size": 28, "weight": "semibold" },
    "pageSubtitle": { "size": 14, "weight": "regular" },
    "sectionTitle": { "size": 16, "weight": "semibold" },
    "cardTitle":    { "size": 14, "weight": "semibold" },
    "cardBody":     { "size": 12, "weight": "regular" },
    "deviceName":   { "size": 15, "weight": "semibold" },
    "badge":        { "size": 11, "weight": "medium" },
    "caption":      { "size": 11, "weight": "regular" },
    "button":       { "size": 13, "weight": "medium" }
  },

  "icons": {
    "$comment": "Mismo concepto en ambas plataformas: SF Symbol (macOS) y glifo Segoe Fluent Icons (Windows).",
    "navBluetooth":  { "sf": "dot.radiowaves.left.and.right", "fluent": "E702" },
    "navLayout":     { "sf": "keyboard",                      "fluent": "E765" },
    "navShortcuts":  { "sf": "command",                       "fluent": "E7FC" },
    "navGuide":      { "sf": "info.circle",                   "fluent": "E946" },
    "keyboard":      { "sf": "keyboard",                      "fluent": "E765" },
    "refresh":       { "sf": "arrow.clockwise",               "fluent": "E72C" },
    "scan":          { "sf": "dot.radiowaves.left.and.right", "fluent": "E721" },
    "connect":       { "sf": "link",                          "fluent": "E71B" },
    "release":       { "sf": "arrow.up.right.square",         "fluent": "E8A7" },
    "disconnect":    { "sf": "bolt.slash",                    "fluent": "E8CD" },
    "filter":        { "sf": "line.3.horizontal.decrease.circle", "fluent": "E71C" },
    "globe":         { "sf": "globe",                         "fluent": "E774" },
    "swap":          { "sf": "arrow.left.arrow.right.square", "fluent": "E8AB" },
    "option":        { "sf": "option",                        "fluent": "E765" },
    "memory":        { "sf": "memorychip",                    "fluent": "E7B8" },
    "command":       { "sf": "command",                       "fluent": "E7FC" },
    "delete":        { "sf": "delete.right",                  "fluent": "E750" },
    "media":         { "sf": "speaker.wave.2",                "fluent": "E767" },
    "info":          { "sf": "info.circle.fill",              "fluent": "E946" },
    "success":       { "sf": "checkmark.circle.fill",         "fluent": "E73E" },
    "uninstall":     { "sf": "trash",                         "fluent": "E74D" },
    "settings":      { "sf": "gearshape",                     "fluent": "E713" },
    "quit":          { "sf": "power",                         "fluent": "E7E8" },
    "batteryFull":   { "sf": "battery.100",                   "fluent": "E83F" },
    "batteryMid":    { "sf": "battery.50",                    "fluent": "E855" },
    "batteryLow":    { "sf": "battery.25",                    "fluent": "E852" }
  }
}
