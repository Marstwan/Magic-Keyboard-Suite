<Window
    x:Class="MagicKeyboardSuite.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Magic Keyboard Suite">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título nativa de WinUI 3 con Mica (mismo formato que en macOS: nombre + versión) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,160,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    VerticalAlignment="Center">
                <FontIcon Glyph="{StaticResource MKSIconKeyboard}" FontSize="13" Foreground="White"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock x:Name="AppTitleText" Grid.Column="1"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />

            <Border Grid.Column="2"
                    Background="{ThemeResource MKSIconTileBrush}"
                    CornerRadius="{StaticResource MKSBadgeCornerRadius}"
                    Padding="8,2" VerticalAlignment="Center">
                <TextBlock x:Name="AppVersionBadgeText"
                           Style="{StaticResource MKSBadgeTextStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
        </Grid>

        <!-- NavigationView idéntico en estructura y medidas a NavigationSplitView de macOS -->
        <NavigationView x:Name="RootNavView"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="{StaticResource MKSSizeSidebarWidth}"
                        SelectionChanged="OnNavSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavBluetoothItem" Tag="bluetooth" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource MKSIconNavBluetooth}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavLayoutItem" Tag="layout">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource MKSIconNavLayout}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavShortcutsItem" Tag="shortcuts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource MKSIconNavShortcuts}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="NavGuideItem" Tag="guide">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="{StaticResource MKSIconNavGuide}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Border Margin="12,8" Padding="14,12"
                        CornerRadius="{StaticResource MKSCardCornerRadius}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="{StaticResource MKSSizeStatusDot}"
                                     Height="{StaticResource MKSSizeStatusDot}"
                                     Fill="{ThemeResource MKSStateConnectedBrush}" />
                            <TextBlock x:Name="FooterEngineText"
                                       Style="{StaticResource MKSBadgeTextStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="ActiveLayoutFooterText"
                                   Style="{StaticResource MKSCaptionTextStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <!-- Área de Contenido Principal -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource MKSPagePadding}">
                <Grid MaxWidth="{StaticResource MKSSizeContentMaxWidth}" HorizontalAlignment="Stretch">

                    <!-- ========================================================= -->
                    <!-- PÁGINA 1: TECLADOS BLUETOOTH                              -->
                    <!-- ========================================================= -->
                    <StackPanel x:Name="BluetoothPage" Spacing="{StaticResource MKSSpacingL}" Visibility="Visible">
                        <Grid Margin="0,0,0,4" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock x:Name="BtTitleText" Style="{StaticResource MKSPageTitleTextStyle}" />
                                <TextBlock x:Name="BtSubtitleText"
                                           Style="{StaticResource MKSPageSubtitleTextStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Click="OnRefreshBluetoothClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{StaticResource MKSIconRefresh}" FontSize="14" />
                                        <TextBlock x:Name="BtRefreshButtonText" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ScanNearbyButton" Click="OnScanNearbyClicked" Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{StaticResource MKSIconScan}" FontSize="14" />
                                        <TextBlock x:Name="BtScanButtonText" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <InfoBar x:Name="StatusInfoBar"
                                 IsOpen="True"
                                 IsClosable="False"
                                 Severity="Informational" />

                        <!-- Lista dinámica de tarjetas KeyboardCard -->
                        <StackPanel x:Name="KeyboardsCardsContainer" Spacing="10" />

                        <!-- Filtro unificado de 3 opciones (idéntico a macOS SwiftUI) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MKSCardCornerRadius}"
                                Padding="{StaticResource MKSCardPadding}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{StaticResource MKSIconFilter}" FontSize="{StaticResource MKSSizeCardIcon}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="BtFilterTitleText" Style="{StaticResource MKSCardTitleTextStyle}" />
                                    <TextBlock x:Name="BtFilterSubtitleText"
                                               Style="{StaticResource MKSCardBodyTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="DeviceFilterComboBox"
                                          Grid.Column="2"
                                          Width="{StaticResource MKSSizeComboWidth}"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnDeviceFilterChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================= -->
                    <!-- PÁGINA 2: DISPOSICIÓN E IDIOMA                            -->
                    <!-- ========================================================= -->
                    <StackPanel x:Name="LayoutPage" Spacing="{StaticResource MKSSpacingL}" Visibility="Collapsed">
                        <StackPanel Spacing="4" Margin="0,0,0,4">
                            <TextBlock x:Name="LayoutTitleText" Style="{StaticResource MKSPageTitleTextStyle}" />
                            <TextBlock x:Name="LayoutSubtitleText"
                                       Style="{StaticResource MKSPageSubtitleTextStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- SettingsCard 0: Drivers de teclado de Apple (Boot Camp) -->
                        <Border x:Name="BootCampDriversCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MKSCardCornerRadius}"
                                Padding="{StaticResource MKSCardPadding}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{StaticResource MKSIconKeyboard}" FontSize="{StaticResource MKSSizeCardIcon}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="DriversTitleText" Style="{StaticResource MKSCardTitleTextStyle}" VerticalAlignment="Center" />
                                        <Border x:Name="DriversStatusBadge"
                                                CornerRadius="{StaticResource MKSBadgeCornerRadius}"
                                                Padding="8,2"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="DriversStatusBadgeText" Style="{StaticResource MKSBadgeTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="DriversSubtitleText"
                                               Style="{StaticResource MKSCardBodyTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ProgressRing x:Name="DriversInstallProgressRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
                                    <Button x:Name="SelectDriversFolderButton" Click="OnSelectDriversFolderClicked">
                                        <TextBlock x:Name="SelectDriversFolderButtonText" TextWrapping="NoWrap" />
                                    </Button>
                                    <Button x:Name="SelectDriversZipButton" Style="{StaticResource AccentButtonStyle}" Click="OnSelectDriversZipClicked">
                                        <TextBlock x:Name="SelectDriversZipButtonText" TextWrapping="NoWrap" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- SettingsCard 1: Disposición de Apple -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MKSCardCornerRadius}"
                                Padding="{StaticResource MKSCardPadding}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{StaticResource MKSIconGlobe}" FontSize="{StaticResource MKSSizeCardIcon}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="LayoutActiveTitleText" Style="{StaticResource MKSCardTitleTextStyle}" />
                                    <TextBlock x:Name="LayoutActiveSubtitleText"
                                               Style="{StaticResource MKSCardBodyTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="LayoutComboBox"
                                          Grid.Column="2"
                                          Width="{StaticResource MKSSizeComboWidth}"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnLayoutSelectionChanged" />
                            </Grid>
                        </Border>

                        <!-- SettingsCard 2: Idioma de la aplicación (Català, Español, English) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MKSCardCornerRadius}"
                                Padding="{StaticResource MKSCardPadding}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{StaticResource MKSIconGlobe}" FontSize="{StaticResource MKSSizeCardIcon}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="LayoutAppLanguageTitleText" Style="{StaticResource MKSCardTitleTextStyle}" />
                                    <TextBlock x:Name="LayoutAppLanguageSubtitleText"
                                               Style="{StaticResource MKSCardBodyTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="AppLanguageComboBox"
                                          Grid.Column="2"
                                          Width="{StaticResource MKSSizeComboWidth}"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnAppLanguageChanged" />
                            </Grid>
                        </Border>

                        <!-- SettingsCard 2: Teclas ISO -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MKSCardCornerRadius}"
                                Padding="{StaticResource MKSCardPadding}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{StaticResource MKSIconSwap}" FontSize="{StaticResource MKSSizeCardIcon}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="LayoutIsoTitleText" Style="{StaticResource MKSCardTitleTextStyle}" />
                                    <TextBlock x:Name="LayoutIsoSubtitleText"
                                               Style="{StaticResource MKSCardBodyTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="IsoSwapToggle" Grid.Column="2" MinWidth="0" Toggled="OnSettingsToggled" />
                            </Grid>
                        </Border>

                        <!-- SettingsCard 3: Option izquierda -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MKSCardCornerRadius}"
                                Padding="{StaticResource MKSCardPadding}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{StaticResource MKSIconOption}" FontSize="{StaticResource MKSSizeCardIcon}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="LayoutOptionTitleText" Style="{StaticResource MKSCardTitleTextStyle}" />
                                    <TextBlock x:Name="LayoutOptionSubtitleText"
                                               Style="{StaticResource MKSCardBodyTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="LeftOptionToggle" Grid.Column="2" MinWidth="0" Toggled="OnSettingsToggled" />
                            </Grid>
                        </Border>

                        <!-- SettingsCard 4: Aplicar solo a teclados Apple -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MKSCardCornerRadius}"
                                Padding="{StaticResource MKSCardPadding}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{StaticResource MKSIconKeyboard}" FontSize="{StaticResource MKSSizeCardIcon}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="LayoutAppleOnlyTitleText" Style="{StaticResource MKSCardTitleTextStyle}" />
                                    <TextBlock x:Name="LayoutAppleOnlySubtitleText"
                                               Style="{StaticResource MKSCardBodyTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="OnlyAppleToggle" Grid.Column="2" MinWidth="0" Toggled="OnSettingsToggled" />
                            </Grid>
                        </Border>

                        <!-- SettingsCard 5: Recordar teclados liberados -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MKSCardCornerRadius}"
                                Padding="{StaticResource MKSCardPadding}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{StaticResource MKSIconMemory}" FontSize="{StaticResource MKSSizeCardIcon}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="LayoutRememberTitleText" Style="{StaticResource MKSCardTitleTextStyle}" />
                                    <TextBlock x:Name="LayoutRememberSubtitleText"
                                               Style="{StaticResource MKSCardBodyTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="RememberReleasedToggle" Grid.Column="2" MinWidth="0" Toggled="OnSettingsToggled" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================= -->
                    <!-- PÁGINA 3: ATAJOS Y MULTIMEDIA                             -->
                    <!-- ========================================================= -->
                    <StackPanel x:Name="ShortcutsPage" Spacing="{StaticResource MKSSpacingL}" Visibility="Collapsed">
                        <StackPanel Spacing="4" Margin="0,0,0,4">
                            <TextBlock x:Name="ShortcutsTitleText" Style="{StaticResource MKSPageTitleTextStyle}" />
                            <TextBlock x:Name="ShortcutsSubtitleText"
                                       Style="{StaticResource MKSPageSubtitleTextStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- SettingsCard 1: Command y Control -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MKSCardCornerRadius}"
                                Padding="{StaticResource MKSCardPadding}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{StaticResource MKSIconCommand}" FontSize="{StaticResource MKSSizeCardIcon}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ShortcutsModifiersTitleText" Style="{StaticResource MKSCardTitleTextStyle}" />
                                    <TextBlock x:Name="ShortcutsModifiersSubtitleText"
                                               Style="{StaticResource MKSCardBodyTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="ModifierModeComboBox"
                                          Grid.Column="2"
                                          Width="{StaticResource MKSSizeComboWidth}"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnModifierModeChanged" />
                            </Grid>
                        </Border>

                        <!-- SettingsCard 2: Supr e Inicio/Fin -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MKSCardCornerRadius}"
                                Padding="{StaticResource MKSCardPadding}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{StaticResource MKSIconDelete}" FontSize="{StaticResource MKSSizeCardIcon}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ShortcutsNavTitleText" Style="{StaticResource MKSCardTitleTextStyle}" />
                                    <TextBlock x:Name="ShortcutsNavSubtitleText"
                                               Style="{StaticResource MKSCardBodyTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="MacNavToggle" Grid.Column="2" MinWidth="0" Toggled="OnSettingsToggled" />
                            </Grid>
                        </Border>

                        <!-- SettingsCard 3: Multimedia F7-F12 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MKSCardCornerRadius}"
                                Padding="{StaticResource MKSCardPadding}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{StaticResource MKSIconMedia}" FontSize="{StaticResource MKSSizeCardIcon}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ShortcutsMediaTitleText" Style="{StaticResource MKSCardTitleTextStyle}" />
                                    <TextBlock x:Name="ShortcutsMediaSubtitleText"
                                               Style="{StaticResource MKSCardBodyTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="MediaKeysToggle" Grid.Column="2" MinWidth="0" Toggled="OnSettingsToggled" />
                            </Grid>
                        </Border>

                        <!-- SettingsCard 4: Option derecho como tecla Fn (opcional, desactivado por defecto) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MKSCardCornerRadius}"
                                Padding="{StaticResource MKSCardPadding}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{StaticResource MKSIconOption}" FontSize="{StaticResource MKSSizeCardIcon}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ShortcutsRightOptionFnTitleText" Style="{StaticResource MKSCardTitleTextStyle}" />
                                    <TextBlock x:Name="ShortcutsRightOptionFnSubtitleText"
                                               Style="{StaticResource MKSCardBodyTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="RightOptionFnToggle" Grid.Column="2" MinWidth="0" Toggled="OnSettingsToggled" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ========================================================= -->
                    <!-- PÁGINA 4: GUÍA WINDOWS <-> MAC                            -->
                    <!-- ========================================================= -->
                    <StackPanel x:Name="GuidePage" Spacing="{StaticResource MKSSpacingL}" Visibility="Collapsed">
                        <StackPanel Spacing="4" Margin="0,0,0,4">
                            <TextBlock x:Name="GuideTitleText" Style="{StaticResource MKSPageTitleTextStyle}" />
                            <TextBlock x:Name="GuideSubtitleText"
                                       Style="{StaticResource MKSPageSubtitleTextStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource MKSCardCornerRadius}"
                                    Padding="20">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{StaticResource MKSIconRelease}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock x:Name="GuideToWindowsTitleText" Style="{StaticResource MKSSectionTitleTextStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="GuideToWindows1Text" Style="{StaticResource MKSCardBodyTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="GuideToWindows2Text" Style="{StaticResource MKSCardBodyTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="GuideToWindows3Text" Style="{StaticResource MKSCardBodyTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource MKSCardCornerRadius}"
                                    Padding="20">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{StaticResource MKSIconConnect}" Foreground="{ThemeResource MKSStateConnectedBrush}" />
                                        <TextBlock x:Name="GuideToMacTitleText" Style="{StaticResource MKSSectionTitleTextStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="GuideToMac1Text" Style="{StaticResource MKSCardBodyTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="GuideToMac2Text" Style="{StaticResource MKSCardBodyTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="GuideToMac3Text" Style="{StaticResource MKSCardBodyTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MKSCardCornerRadius}"
                                Padding="20">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="GuideSymbolsTitleText" Style="{StaticResource MKSSectionTitleTextStyle}" />
                                <TextBlock x:Name="GuideSymbols1Text" Style="{StaticResource MKSCardBodyTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="GuideSymbols2Text" Style="{StaticResource MKSCardBodyTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="GuideSymbols3Text" Style="{StaticResource MKSCardBodyTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Tarjeta para volver a abrir la guía de bienvenida -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MKSCardCornerRadius}"
                                Padding="{StaticResource MKSCardPadding}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{StaticResource MKSIconNavGuide}" FontSize="{StaticResource MKSSizeCardIcon}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="ReopenOnboardingTitleText" Style="{StaticResource MKSCardTitleTextStyle}" />
                                    <TextBlock x:Name="ReopenOnboardingSubtitleText"
                                               Style="{StaticResource MKSCardBodyTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Click="OnReopenOnboardingClicked" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{StaticResource MKSIconNavGuide}" FontSize="14" />
                                        <TextBlock x:Name="ReopenOnboardingButtonText" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Tarjeta de Desinstalación -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MKSCardCornerRadius}"
                                Padding="{StaticResource MKSCardPadding}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{StaticResource MKSIconUninstall}" FontSize="{StaticResource MKSSizeCardIcon}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="UninstallTitleText" Style="{StaticResource MKSCardTitleTextStyle}" />
                                    <TextBlock x:Name="UninstallSubtitleText"
                                               Style="{StaticResource MKSCardBodyTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Click="OnUninstallClicked" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{StaticResource MKSIconUninstall}" FontSize="14" />
                                        <TextBlock x:Name="UninstallButtonText" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </NavigationView>

        <!-- Modal de Bienvenida en 2 pantallas (Pantalla 1: Idioma + Drivers Boot Camp -> Pantalla 2: Guía de uso) -->
        <Grid x:Name="OnboardingOverlay"
              Grid.Row="0" Grid.RowSpan="2"
              Background="#73000000"
              Visibility="Collapsed">
            <Border MaxWidth="660"
                    Margin="24"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <!-- PANTALLA 1: CONFIGURACIÓN INICIAL (IDIOMA + DRIVERS BOOT CAMP) -->
                    <StackPanel x:Name="OnboardingSetupPanel" Spacing="16" Visibility="Visible">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="{StaticResource MKSSizeIconTile}"
                                    Height="{StaticResource MKSSizeIconTile}"
                                    CornerRadius="{StaticResource MKSIconTileCornerRadius}"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="{StaticResource MKSIconKeyboard}"
                                          FontSize="{StaticResource MKSSizeTileIcon}"
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="OnboardingSetupBadgeText"
                                           Style="{StaticResource MKSBadgeTextStyle}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="OnboardingSetupTitleText"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="OnboardingSetupSubtitleText"
                                   Style="{StaticResource MKSCardBodyTextStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <!-- Tarjeta 1: Idioma de la aplicación -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MKSCardCornerRadius}"
                                Padding="{StaticResource MKSCardPadding}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="{StaticResource MKSIconGlobe}" FontSize="{StaticResource MKSSizeCardIcon}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="OnboardingLangTitleText" Style="{StaticResource MKSCardTitleTextStyle}" />
                                    <TextBlock x:Name="OnboardingLangSubtitleText"
                                               Style="{StaticResource MKSCardBodyTextStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="OnboardingLanguageComboBox"
                                          Grid.Column="2"
                                          Width="{StaticResource MKSSizeComboWidth}"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnOnboardingLanguageChanged" />
                            </Grid>
                        </Border>

                        <!-- Tarjeta 2: Drivers oficiales de Apple (Boot Camp) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource MKSCardCornerRadius}"
                                Padding="{StaticResource MKSCardPadding}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="{StaticResource MKSIconKeyboard}" FontSize="{StaticResource MKSSizeCardIcon}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="OnboardingDriversTitleText" Style="{StaticResource MKSCardTitleTextStyle}" VerticalAlignment="Center" />
                                            <Border x:Name="OnboardingDriversStatusBadge"
                                                    CornerRadius="{StaticResource MKSBadgeCornerRadius}"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="OnboardingDriversStatusBadgeText" Style="{StaticResource MKSBadgeTextStyle}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="OnboardingDriversSubtitleText"
                                                   Style="{StaticResource MKSCardBodyTextStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <ProgressRing x:Name="OnboardingDriversProgressRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
                                    <Button x:Name="OnboardingSelectDriversFolderButton" Click="OnSelectDriversFolderClicked">
                                        <TextBlock x:Name="OnboardingSelectDriversFolderButtonText" TextWrapping="NoWrap" />
                                    </Button>
                                    <Button x:Name="OnboardingSelectDriversZipButton" Style="{StaticResource AccentButtonStyle}" Click="OnSelectDriversZipClicked">
                                        <TextBlock x:Name="OnboardingSelectDriversZipButtonText" TextWrapping="NoWrap" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,4,0,0">
                            <Button x:Name="OnboardingNextButton"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnOnboardingNextClicked">
                                <TextBlock x:Name="OnboardingNextButtonText" TextWrapping="NoWrap" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- PANTALLA 2: GUÍA DE INICIO RÁPIDO (3 PASOS) -->
                    <StackPanel x:Name="OnboardingGuidePanel" Spacing="16" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="{StaticResource MKSSizeIconTile}"
                                    Height="{StaticResource MKSSizeIconTile}"
                                    CornerRadius="{StaticResource MKSIconTileCornerRadius}"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="{StaticResource MKSIconKeyboard}"
                                          FontSize="{StaticResource MKSSizeTileIcon}"
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="OnboardingBadgeText"
                                           Style="{StaticResource MKSBadgeTextStyle}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="OnboardingTitleText"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="OnboardingSubtitleText"
                                   Style="{StaticResource MKSCardBodyTextStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel Spacing="10">
                            <!-- Paso 1 -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource MKSCardCornerRadius}"
                                    Padding="16,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38"
                                            CornerRadius="{StaticResource MKSIconTileCornerRadius}"
                                            Background="{ThemeResource MKSStateNearbyFillBrush}"
                                            VerticalAlignment="Top">
                                        <FontIcon Glyph="{StaticResource MKSIconNavBluetooth}"
                                                  FontSize="16"
                                                  Foreground="{ThemeResource MKSStateNearbyBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock x:Name="OnboardingStep1TitleText" Style="{StaticResource MKSCardTitleTextStyle}" />
                                        <TextBlock x:Name="OnboardingStep1BodyText"
                                                   Style="{StaticResource MKSCardBodyTextStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Paso 2 -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource MKSCardCornerRadius}"
                                    Padding="16,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38"
                                            CornerRadius="{StaticResource MKSIconTileCornerRadius}"
                                            Background="{ThemeResource MKSStateConnectedFillBrush}"
                                            VerticalAlignment="Top">
                                        <FontIcon Glyph="{StaticResource MKSIconGlobe}"
                                                  FontSize="16"
                                                  Foreground="{ThemeResource MKSStateConnectedBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock x:Name="OnboardingStep2TitleText" Style="{StaticResource MKSCardTitleTextStyle}" />
                                        <TextBlock x:Name="OnboardingStep2BodyText"
                                                   Style="{StaticResource MKSCardBodyTextStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Paso 3 -->
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource MKSCardCornerRadius}"
                                    Padding="16,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38"
                                            CornerRadius="{StaticResource MKSIconTileCornerRadius}"
                                            Background="{ThemeResource MKSStateReleasedFillBrush}"
                                            VerticalAlignment="Top">
                                        <FontIcon Glyph="{StaticResource MKSIconCommand}"
                                                  FontSize="16"
                                                  Foreground="{ThemeResource MKSStateReleasedBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock x:Name="OnboardingStep3TitleText" Style="{StaticResource MKSCardTitleTextStyle}" />
                                        <TextBlock x:Name="OnboardingStep3BodyText"
                                                   Style="{StaticResource MKSCardBodyTextStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Grid ColumnSpacing="12" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="OnboardingReopenHintText"
                                       Grid.Column="0"
                                       Style="{StaticResource MKSCaptionTextStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="OnboardingBackButton"
                                    Grid.Column="1"
                                    Click="OnOnboardingBackClicked"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="OnboardingBackButtonText" TextWrapping="NoWrap" />
                            </Button>
                            <Button x:Name="OnboardingStartButton"
                                    Grid.Column="2"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="OnDismissOnboardingClicked"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="OnboardingStartButtonText" TextWrapping="NoWrap" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
