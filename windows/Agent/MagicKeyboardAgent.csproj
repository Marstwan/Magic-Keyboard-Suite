<Project Sdk="Microsoft.NET.Sdk">
  <!-- Agente en segundo plano (bandeja del sistema). .NET Framework 4.8 viene de serie en Windows 10/11,
       así que el instalador no necesita instalar ningún runtime adicional. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MagicKeyboardAgent</AssemblyName>
    <RootNamespace>MagicKeyboardSuite</RootNamespace>
    <ApplicationIcon>..\..\shared\assets\AppIcon.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="MagicKeyboardContext.cs" />
    <Compile Include="KeyboardHookEngine.cs" />
    <Compile Include="Hid\AppleHidRawInput.cs" />
    <Compile Include="Diagnostics\FnDiagnosticForm.cs" />
    <Compile Include="..\Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Permite compilar net48 de forma reproducible sin depender de instalaciones globales -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
